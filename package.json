{
  "name": "appfactory",
  "version": "2.0.0",
  "description": "AppFactory \u2014 global apps ported to HarmonyOS & OpenHarmony (Node.js showcase site)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "build": "vite build",
    "start": "node server.js",
    "dev": "concurrently -n api,web -c blue,green \"node --watch server.js\" \"vite\"",
    "dev:api": "node --watch server.js",
    "dev:web": "vite",
    "preview": "npm run build && npm start",
    "shots": "python3 scripts/fetch-shots.py",
    "test": "node scripts/api-test.js && node scripts/build-test.js",
    "test:api": "node scripts/api-test.js",
    "test:build": "node scripts/build-test.js"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.22.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "jsdom": "^22.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2"
  },
  "keywords": [],
  "author": ""
}
